# Docker Compose connects from its containers to Besu running on the Mac host.
BESU_RPC_URL=http://host.docker.internal:8545
BESU_RPC_TIMEOUT_MS=5000

# Optional protection for contract add/pause/reindex/remove operations in the
# internal UI. Set a long random value outside local development.
CONTRACT_ADMIN_TOKEN=

# Comma-separated allowlist. Events and top-level transactions are indexed only
# for these contracts.
INDEXER_CONTRACT_ADDRESSES=0xaf75636C88b9c70FbCE5a5d2772F7F6a8d56C132

# These values bootstrap the persistent tracked-contract configuration on its
# first run. Add more contracts later from the Contracts page without restart.
INDEXER_START_BLOCK=0
INDEXER_TOPIC0=
INDEXER_CONFIRMATIONS=0
INDEXER_BATCH_SIZE=500
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_REORG_LOOKBACK=128

# The SQLite index is intentionally ephemeral and stored in RAM. It is rebuilt
# from Besu after every container restart. Contract configuration remains in a
# small persistent Docker volume.
SQLITE_TMPFS_SIZE=256m
CONTAINER_MEMORY_LIMIT=1g
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
